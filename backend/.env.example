# =============================================================================
# CivicFix - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# =============================================================================

# Supabase PostgreSQL Password (from Supabase Dashboard > Settings > Database)
SUPABASE_DB_PASSWORD=your_supabase_password_here

# JWT Signing Secret (use a random 64-character string)
JWT_SECRET=your-jwt-secret-key-here
