<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        PARENT: Spring Boot Starter Parent
        This is the "master recipe book" for Spring Boot.
        It pre-configures hundreds of dependency versions so we don't have
        to manually hunt for compatible library versions.
        Spring Boot 3.2.x requires Java 17 or higher.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <!--
        PROJECT COORDINATES:
        groupId    = our organization namespace (like a package name)
        artifactId = the project name (used as the JAR filename)
        version    = our current version
    -->
    <groupId>com.civicfix</groupId>
    <artifactId>civicfix-backend</artifactId>
    <version>0.1.0</version>
    <name>CivicFix Backend</name>
    <description>AI-Powered Municipal Grievance Management System - Backend API</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!--
            1. SPRING BOOT STARTER WEB
            What it gives us:
            - An embedded Tomcat web server (no separate server install needed)
            - Spring MVC for building REST controllers (@RestController, @GetMapping, etc.)
            - Jackson JSON serializer (automatically converts Java objects to/from JSON)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            2. SPRING BOOT STARTER DATA JPA
            What it gives us:
            - Hibernate ORM (maps Java classes to database tables automatically)
            - Spring Data JPA (write repository interfaces, Spring generates SQL queries)
            - Transaction management (@Transactional)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            3. SPRING BOOT STARTER SECURITY
            What it gives us:
            - Authentication filters (JWT processing)
            - Authorization (@PreAuthorize role checks)
            - Password encoding (BCryptPasswordEncoder)
            - CORS configuration
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            4. SPRING BOOT STARTER VALIDATION
            What it gives us:
            - Jakarta Bean Validation annotations (@NotBlank, @Size, @Email, etc.)
            - Automatic request body validation before our controller code runs
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            5. POSTGRESQL JDBC DRIVER
            The "translator" that lets Java speak PostgreSQL's wire protocol.
            Without this, Spring Boot cannot connect to any PostgreSQL database.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            6. HIBERNATE SPATIAL
            Extends Hibernate ORM to understand PostGIS spatial types.
            Without this, Hibernate would not know how to map a
            GEOMETRY(Point, 4326) column to a Java object.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-spatial</artifactId>
        </dependency>

        <!--
            7. JWT LIBRARIES (io.jsonwebtoken / jjwt)
            Three JARs that let us create, sign, and verify JWT tokens:
            - jjwt-api: The public API interfaces
            - jjwt-impl: The implementation code
            - jjwt-jackson: JSON serialization for JWT payloads
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            8. LOMBOK (Optional but helpful)
            Generates boilerplate code (getters, setters, constructors)
            at compile time so our entity classes stay clean and readable.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            9. SPRING BOOT STARTER TEST
            JUnit 5 + Mockito + Spring Test utilities for writing tests.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            10. SPRING SECURITY TEST
            Helpers like @WithMockUser for testing secured endpoints.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                SPRING BOOT MAVEN PLUGIN
                Packages our application into a single executable JAR file
                and provides the `mvn spring-boot:run` command.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
